* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #080810;
  --bg-soft: #0a0a14;
  --panel: #0f0f28;
  --panel-2: #131338;
  --line: #1c1c48;
  --line-strong: #252550;
  --text: #e0e0e0;
  --muted: #7f82a8;
  --muted-2: #4d5075;
  --accent: #00d4ff;
  --accent-2: #0095b8;
  --danger: #ff4444;
  --warning: #ffaa00;
  --success: #00ff88;
  --shadow: rgba(0, 212, 255, 0.22);
}

html,
body,
#root {
  min-height: 100%;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  padding-bottom: 78px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

button,
input,
textarea,
select {
  font: inherit;
}

.header {
  background: linear-gradient(180deg, var(--panel), var(--bg-soft));
  padding: 12px 14px 14px;
  text-align: center;
  border-bottom: 1px solid var(--line);
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(10px);
}

.header-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
  position: relative;
}

.header-spacer {
  width: 38px;
  height: 38px;
}

.theme-picker-wrap {
  position: relative;
}

.theme-toggle {
  width: 38px;
  height: 38px;
  border: 1px solid var(--line-strong);
  border-radius: 12px;
  background: rgba(0, 0, 0, 0.18);
  color: var(--accent);
  cursor: pointer;
  font-size: 18px;
}

.theme-menu {
  position: absolute;
  top: 44px;
  right: 0;
  width: 150px;
  background: linear-gradient(145deg, var(--panel), var(--panel-2));
  border: 1px solid var(--line-strong);
  border-radius: 14px;
  padding: 8px;
  display: grid;
  gap: 6px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
}

.theme-option {
  border: 1px solid transparent;
  background: rgba(0, 0, 0, 0.14);
  color: var(--text);
  border-radius: 10px;
  padding: 9px 10px;
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  text-align: left;
  font-size: 13px;
}

.theme-option.active {
  border-color: var(--accent);
  color: var(--accent);
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 6px;
}

.header-icon {
  font-size: 28px;
  line-height: 1;
}

.header-title {
  font-size: clamp(18px, 4vw, 28px);
  font-weight: 800;
  color: var(--accent);
  letter-spacing: 1px;
  text-transform: uppercase;
  text-shadow: 0 0 22px var(--shadow);
}

.header-date,
.theme-caption {
  font-size: 12px;
  color: var(--muted);
}

.theme-caption {
  margin-top: 4px;
}

.day-nav {
  display: flex;
  justify-content: center;
  padding: 14px 12px 0;
  background: var(--bg-soft);
}

.day-nav-inner {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  width: 100%;
  max-width: 640px;
}

.day-tab {
  min-width: 0;
  padding: 12px 8px;
  background: color-mix(in srgb, var(--panel) 82%, black 18%);
  border: 1px solid var(--line);
  border-radius: 14px;
  color: var(--muted);
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.25s ease;
  text-align: center;
}

.day-tab.active {
  background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 18%, transparent), color-mix(in srgb, var(--accent-2) 18%, transparent));
  color: var(--accent);
  border-color: var(--accent);
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent), 0 10px 24px color-mix(in srgb, var(--accent) 12%, transparent);
}

.day-tab-day {
  display: block;
  font-size: 15px;
  font-weight: 800;
}

.day-tab-name {
  display: block;
  font-size: 10px;
  margin-top: 3px;
  opacity: 0.9;
}

.workout-section,
.settings-page {
  width: min(100%, 720px);
  margin: 0 auto;
  padding: 14px 12px 18px;
}

.workout-title {
  font-size: clamp(15px, 3.7vw, 19px);
  color: var(--accent);
  margin-bottom: 14px;
  font-weight: 700;
  line-height: 1.35;
}

.workout-title span {
  color: var(--text);
}

.exercise-card,
.settings-card,
.settings-info {
  background: linear-gradient(145deg, var(--panel), var(--panel-2));
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 14px;
  margin-bottom: 12px;
}

.exercise-card {
  transition: transform 0.15s ease, border-color 0.2s ease, opacity 0.2s ease;
}

.exercise-card.dragging {
  opacity: 0.55;
}

.exercise-card.drag-over {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
}

.exercise-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 12px;
}

.exercise-info {
  flex: 1;
  min-width: 0;
}

.exercise-name {
  font-size: clamp(16px, 4.4vw, 19px);
  font-weight: 800;
  color: #fff;
  margin-bottom: 7px;
  line-height: 1.15;
  word-break: break-word;
}

.exercise-badges {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.exercise-badge {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  padding: 4px 8px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.badge-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  display: inline-block;
  flex-shrink: 0;
}

.badge-main {
  color: var(--danger);
  background: color-mix(in srgb, var(--danger) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--danger) 22%, transparent);
}

.badge-main .badge-dot {
  background: var(--danger);
}

.badge-sub {
  color: var(--warning);
  background: color-mix(in srgb, var(--warning) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--warning) 22%, transparent);
}

.badge-sub .badge-dot {
  background: var(--warning);
}

.badge-heavy {
  color: var(--danger);
  background: color-mix(in srgb, var(--danger) 8%, transparent);
  border: 1px solid color-mix(in srgb, var(--danger) 16%, transparent);
}

.badge-medium {
  color: var(--warning);
  background: color-mix(in srgb, var(--warning) 8%, transparent);
  border: 1px solid color-mix(in srgb, var(--warning) 16%, transparent);
}

.badge-light {
  color: var(--success);
  background: color-mix(in srgb, var(--success) 8%, transparent);
  border: 1px solid color-mix(in srgb, var(--success) 16%, transparent);
}

.exercise-actions {
  display: flex;
  gap: 4px;
  flex-shrink: 0;
}

.btn-icon {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  border: 1px solid var(--line-strong);
  background: rgba(0, 0, 0, 0.16);
  color: var(--muted);
  font-size: 12px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: 0.2s ease;
  -webkit-tap-highlight-color: transparent;
}

.btn-icon:active {
  transform: scale(0.94);
}

.btn-level {
  color: var(--accent);
  border-color: color-mix(in srgb, var(--accent) 36%, transparent);
  font-size: 14px;
}

.btn-dragger {
  color: var(--muted);
  cursor: grab;
  font-size: 11px;
  letter-spacing: -1px;
}

.btn-edit {
  border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  color: var(--accent);
}

.btn-del {
  border-color: color-mix(in srgb, var(--danger) 35%, transparent);
  color: var(--danger);
}

.inputs-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-bottom: 12px;
}

.input-group {
  min-width: 0;
}

.input-label {
  display: block;
  font-size: 10px;
  color: var(--muted);
  margin-bottom: 5px;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  font-weight: 600;
}

.input-field {
  width: 100%;
  padding: 10px 6px;
  border: 1px solid var(--line-strong);
  border-radius: 10px;
  background: color-mix(in srgb, var(--bg) 88%, black 12%);
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  outline: none;
  transition: 0.25s ease;
  -moz-appearance: textfield;
  min-width: 0;
}

.compact-input {
  padding: 9px 4px;
  font-size: 15px;
}

.input-field::-webkit-outer-spin-button,
.input-field::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.input-field:focus,
.comment-input:focus,
.modal-input:focus,
.modal-select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
}

.comment-area {
  margin-bottom: 10px;
  animation: slideDown 0.22s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    max-height: 0;
  }
  to {
    opacity: 1;
    max-height: 200px;
  }
}

.comment-input {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--line-strong);
  border-radius: 10px;
  background: color-mix(in srgb, var(--bg) 88%, black 12%);
  color: #fff;
  font-size: 13px;
  outline: none;
  resize: vertical;
  min-height: 54px;
}

.comment-input::placeholder,
.modal-input::placeholder {
  color: var(--muted-2);
}

.last-result {
  background: color-mix(in srgb, var(--accent) 6%, transparent);
  border: 1px solid color-mix(in srgb, var(--accent) 14%, transparent);
  border-radius: 10px;
  padding: 10px 12px;
  margin-bottom: 10px;
  font-size: 12px;
  color: var(--muted);
  line-height: 1.45;
  word-break: break-word;
}

.last-result strong {
  color: var(--accent);
}

.result-comment {
  color: var(--warning);
  font-style: italic;
}

.result-date {
  color: var(--muted-2);
}

.save-area {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.btn-save {
  flex: 1;
  padding: 11px 12px;
  border: none;
  border-radius: 11px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #000;
  font-size: 14px;
  font-weight: 800;
  cursor: pointer;
  transition: 0.2s ease;
  letter-spacing: 0.2px;
  box-shadow: 0 6px 20px var(--shadow);
}

.btn-save:active,
.btn-comment-toggle:active,
.btn-add:active,
.btn-finish:active,
.modal-btn:active,
.settings-btn:active,
.theme-toggle:active {
  transform: scale(0.98);
}

.btn-comment-toggle {
  width: 42px;
  min-width: 42px;
  height: 42px;
  border-radius: 11px;
  border: 1px solid var(--line-strong);
  background: color-mix(in srgb, var(--bg) 86%, black 14%);
  color: var(--muted);
  font-size: 16px;
  cursor: pointer;
}

.btn-comment-toggle.active {
  border-color: var(--warning);
  color: var(--warning);
  background: color-mix(in srgb, var(--warning) 8%, transparent);
}

.history-section {
  padding-top: 10px;
  border-top: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: var(--muted);
}

.history-header-left {
  display: flex;
  align-items: center;
  gap: 6px;
}

.history-toggle,
.history-delete {
  background: none;
  border: none;
  cursor: pointer;
}

.history-toggle {
  color: var(--accent);
  font-size: 13px;
  padding: 4px 0;
}

.history-list {
  margin-top: 8px;
  display: grid;
  gap: 6px;
}

.history-item {
  display: grid;
  grid-template-columns: auto auto 1fr auto;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  background: color-mix(in srgb, var(--bg) 90%, black 10%);
  border-radius: 10px;
  font-size: 12px;
}

.history-date {
  color: var(--muted-2);
  white-space: nowrap;
}

.history-data {
  color: var(--accent);
  font-weight: 700;
  white-space: nowrap;
}

.history-comment {
  color: var(--warning);
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-delete {
  color: color-mix(in srgb, var(--danger) 70%, transparent);
  font-size: 12px;
  padding: 2px 4px;
}

.history-empty {
  font-size: 12px;
  color: var(--muted-2);
  text-align: center;
  padding: 10px;
}

.btn-add,
.btn-finish,
.settings-btn,
.modal-btn {
  width: 100%;
  border-radius: 14px;
  cursor: pointer;
}

.btn-add {
  padding: 13px;
  border: 1.5px dashed var(--line-strong);
  background: transparent;
  color: var(--muted);
  font-size: 14px;
  margin-bottom: 10px;
}

.btn-finish {
  padding: 15px;
  border: none;
  background: linear-gradient(135deg, var(--danger), color-mix(in srgb, var(--danger) 68%, black 32%));
  color: #fff;
  font-size: 15px;
  font-weight: 800;
  box-shadow: 0 8px 24px color-mix(in srgb, var(--danger) 20%, transparent);
}

.settings-title {
  font-size: 20px;
  color: var(--accent);
  margin-bottom: 18px;
  font-weight: 800;
}

.settings-card-title {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 1.4px;
  font-weight: 800;
}

.settings-btn {
  padding: 13px;
  border: 1px solid var(--line-strong);
  background: color-mix(in srgb, var(--bg) 86%, black 14%);
  color: var(--text);
  font-size: 14px;
  margin-bottom: 8px;
}

.settings-btn-danger {
  border-color: color-mix(in srgb, var(--danger) 35%, transparent);
  color: var(--danger);
}

.theme-list-settings {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.theme-settings-btn.active {
  border-color: var(--accent);
  color: var(--accent);
}

.settings-info {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.65;
}

.hidden-input {
  display: none;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  z-index: 200;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 14px;
}

.modal {
  background: linear-gradient(145deg, var(--panel), var(--panel-2));
  border: 1px solid var(--line-strong);
  border-radius: 20px;
  padding: 18px;
  width: min(100%, 400px);
}

.modal-title {
  font-size: 18px;
  color: var(--accent);
  margin-bottom: 18px;
  font-weight: 800;
}

.modal-field {
  margin-bottom: 14px;
}

.modal-label {
  display: block;
  font-size: 11px;
  color: var(--muted);
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 700;
}

.modal-input,
.modal-select {
  width: 100%;
  padding: 12px 13px;
  border: 1px solid var(--line-strong);
  border-radius: 11px;
  background: color-mix(in srgb, var(--bg) 88%, black 12%);
  color: var(--text);
  font-size: 15px;
  outline: none;
}

.modal-select {
  appearance: none;
}

.modal-actions {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}

.modal-btn-confirm {
  border: none;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #000;
  font-weight: 800;
  padding: 13px;
}

.modal-btn-cancel {
  border: 1px solid var(--line-strong);
  background: color-mix(in srgb, var(--bg) 86%, black 14%);
  color: var(--muted);
  padding: 13px;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 88px;
  transform: translateX(-50%) translateY(18px);
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #000;
  padding: 10px 18px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 800;
  opacity: 0;
  pointer-events: none;
  transition: 0.25s ease;
  z-index: 300;
  max-width: calc(100vw - 24px);
  text-align: center;
}

.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: color-mix(in srgb, var(--bg-soft) 86%, black 14%);
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-around;
  padding: 6px 8px 10px;
  z-index: 110;
  backdrop-filter: blur(10px);
}

.bottom-btn {
  background: none;
  border: none;
  color: var(--muted-2);
  font-size: 10px;
  cursor: pointer;
  text-align: center;
  padding: 4px 14px;
}

.bottom-btn.active {
  color: var(--accent);
}

.bottom-icon {
  font-size: 21px;
  display: block;
  margin-bottom: 2px;
}

.bottom-label {
  display: block;
  font-weight: 700;
}

@media (max-width: 560px) {
  .header {
    padding-left: 10px;
    padding-right: 10px;
  }

  .workout-section,
  .settings-page {
    padding-left: 10px;
    padding-right: 10px;
  }

  .exercise-card,
  .settings-card,
  .settings-info {
    padding: 12px;
    border-radius: 16px;
  }

  .exercise-header {
    align-items: flex-start;
  }

  .history-item {
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'date delete'
      'data data'
      'comment comment';
    align-items: start;
  }

  .history-date {
    grid-area: date;
  }

  .history-data {
    grid-area: data;
  }

  .history-comment {
    grid-area: comment;
    white-space: normal;
  }

  .history-delete {
    grid-area: delete;
    justify-self: end;
  }
}

@media (max-width: 420px) {
  .day-nav-inner {
    gap: 8px;
  }

  .day-tab {
    padding: 10px 6px;
    border-radius: 12px;
  }

  .day-tab-day {
    font-size: 14px;
  }

  .day-tab-name {
    font-size: 9px;
  }

  .exercise-actions {
    gap: 3px;
  }

  .btn-icon {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    font-size: 11px;
  }

  .btn-level {
    font-size: 13px;
  }

  .inputs-row {
    gap: 6px;
  }

  .input-label {
    font-size: 9px;
  }

  .compact-input {
    padding: 8px 2px;
    font-size: 14px;
  }

  .save-area {
    gap: 6px;
  }

  .btn-save {
    padding: 10px 10px;
    font-size: 13px;
  }

  .btn-comment-toggle {
    width: 40px;
    min-width: 40px;
    height: 40px;
  }

  .theme-list-settings {
    grid-template-columns: 1fr;
  }
}
